return `<article class="topic ${done?'is-done':''}" id="${d.id}"><div class="topic-head" role="button" tabindex="0" aria-expanded="${open}" data-toggle="${d.id}"><div class="topic-main"><div class="topic-meta"><span class="level l${d.level}">${levelLabel(d.level)}</span><span class="page-ref">WEEK ${d.w} · PDF ${escapeHTML(d.pages)}쪽</span></div><h3>${escapeHTML(d.title)}</h3></div><button class="topic-toggle" tabindex="-1" aria-hidden="true">${open?'−':'+'}</button></div><div class="topic-body" ${open?'':'hidden'}>${body}</div></article>`}
function renderTopics(){const items=visibleData();$('#resultsCount').textContent=`${items.length}개 개념`;$('#topics').innerHTML=items.length?items.map(renderCard).join(''):`<div class="empty">일치하는 개념이 없어요.<br>검색어 또는 필터를 변경해 보세요.</div>`;renderOverview();renderProgress()}
function updateView(){let notes=['all','7','8','9'].includes(state.view);$('#studyView').classList.toggle('active',notes);$('#compareView').classList.toggle('active',state.view==='compare');$('#glossaryView').classList.toggle('active',state.view==='glossary');$$('[data-view]').forEach(b=>b.classList.toggle('active',b.dataset.view===state.view));let current=state.view==='all'?'전체 개념':META[state.view]?.label||({compare:'핵심 비교표',glossary:'핵심 용어집',plan:'공부 순서 가이드'}[state.view]);$('#breadcrumb').textContent=`컴퓨터비전 / ${current}`;$('#listTitle').textContent=state.view==='all'?'전체 개념 정리':`${state.view}주차 · ${META[state.view]?.label||''}`;$('#listDesc').textContent=state.view==='all'?'7~9주차의 개념을 주제별로 정리했습니다.':`${META[state.view]?.desc||''} · 출처 ${META[state.view]?.pages||''}`;renderTopics();window.scrollTo({top:0,behavior:'smooth'})}
function setView(v){state.view=String(v);state.query='';$('#searchInput').value='';state.level='all';state.incomplete=false;$('#incompleteOnly').checked=false;$$('[data-level]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.level==='all'));updateView();closeMenu()}
function closeMenu(){$('#sidebar').classList.remove('open');$('#backdrop').classList.remove('active')}
function toast(s){let el=$('#toast');el.textContent=s;el.classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>el.classList.remove('show'),1600)}
function renderExtra(){let q=state.query.toLowerCase();$('#compareGallery').innerHTML=COMPARES.filter(a=>!q||a.join(' ').toLowerCase().includes(q)).map(a=>`<div class="compare-card"><h3>${escapeHTML(a[0])}</h3><div class="compare-items">${[[a[1],a[2]],[a[3],a[4]],[a[5],a[6]]].map(pair=>`<div class="compare-pair"><b>${escapeHTML(pair[0])}</b><span>${escapeHTML(pair[1])}</span></div>`).join('')}</div></div>`).join('');$('#glossary').innerHTML=GLOSSARY.filter(x=>!q||x.join(' ').toLowerCase().includes(q)).map(g=>`<div class="gloss-item"><strong>${escapeHTML(g[0])}</strong><p>${escapeHTML(g[1])}</p><div class="page-ref" style="margin-top:7px">WEEK ${g[2]}</div></div>`).join('')}
$$('[data-view]').forEach(b=>b.addEventListener('click',()=>setView(b.dataset.view)));
$('#overview').addEventListener('click',e=>{const b=e.target.closest('[data-go]');if(b)setView(b.dataset.go)});
$('#topics').addEventListener('click',e=>{const b=e.target.closest('[data-done]');if(b){const id=b.dataset.done;if(state.done.has(id))state.done.delete(id);else state.done.add(id);try{localStorage.setItem(STORAGE,JSON.stringify([...state.done]))}catch(e){}renderTopics();toast(state.done.has(id)?'학습 완료를 기록했어요':'완료 표시를 해제했어요');return;}const h=e.target.closest('[data-toggle]');if(h){const id=h.dataset.toggle;if(state.expanded.has(id))state.expanded.delete(id);else state.expanded.add(id);const card=document.getElementById(id);const bd=card?.querySelector('.topic-body');if(bd)bd.hidden=!state.expanded.has(id);h.setAttribute('aria-expanded',state.expanded.has(id)?'true':'false');let btn=h.querySelector('.topic-toggle');if(btn)btn.textContent=state.expanded.has(id)?'−':'+'}});
$('#topics').addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&e.target.matches('[data-toggle]')){e.preventDefault();e.target.click()}});
$('#searchInput').addEventListener('input',e=>{state.query=e.target.value.trim();if(!['all','7','8','9'].includes(state.view)){renderExtra()}else{renderTopics();if(state.query){visibleData().forEach(d=>state.expanded.add(d.id));renderTopics()}}});
$$('[data-level]').forEach(b=>b.addEventListener('click',()=>{state.level=b.dataset.level;$$('[data-level]').forEach(x=>x.setAttribute('aria-pressed',x===b?'true':'false'));renderTopics()}));
$('#incompleteOnly').addEventListener('change',e=>{state.incomplete=e.target.checked;renderTopics()});
$('#expandAll').addEventListener('click',()=>{visibleData().forEach(d=>state.expanded.add(d.id));renderTopics()});
$('#collapseAll').addEventListener('click',()=>{state.expanded.clear();renderTopics()});
$('#themeBtn').addEventListener('click',()=>{state.theme=state.theme==='light'?'dark':'light';document.documentElement.dataset.theme=state.theme;try{localStorage.setItem(THEME_STORAGE,state.theme)}catch(e){}});
$('#menuBtn').addEventListener('click',()=>{$('#sidebar').classList.toggle('open');$('#backdrop').classList.toggle('active')});$('#backdrop').addEventListener('click',closeMenu);
DATA.forEach(d=>state.expanded.add(d.id));renderExtra();updateView();
</script></body></html>
