function visibleData(){return DATA.filter(d=>(state.view==='all'||String(d.w)===state.view)&&(state.level==='all'||String(d.level)===state.level)&&(!state.incomplete||!state.done.has(d.id))&&(!state.query||JSON.stringify(d).toLowerCase().includes(state.query.toLowerCase())))}
